              "href": "/contas-correntes-omie",
              "actionLabel": "Ver contas correntes"
            }
          ]
        }
      ]
    }
  ],
  "collections": [
    {
      "model": "Compra",
      "mode": "dynamic",
      "path": "/compras",
      "label": "Documentos fiscais",
      "section": "Operação",
      "form": [
        {
          "field": "categoriaFinanceiraId",
          "referenceFilters": {
            "status": "Ativo"
          }
        },
        {
          "field": "contaCorrenteFinanceiraId",
          "referenceFilters": {
            "status": "Ativo"
          }
        }
      ],
      "list": {
        "filters": [
          {
            "field": "tipoDocumentoFiscal",
            "label": "Tipo de documento",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "NF-e",
                "value": "NF-e"
              },
              {
                "label": "CT-e",
                "value": "CT-e"
              },
              {
                "label": "Outro",
                "value": "Outro"
              }
            ]
          },
          {
            "field": "statusDocumentoOmie",
            "label": "Status no Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Recebido",
                "value": "Recebido"
              },
              {
                "label": "Cancelado",
                "value": "Cancelado"
              },
              {
                "label": "Devolvido",
                "value": "Devolvido"
              },
              {
                "label": "Denegado",
                "value": "Denegado"
              }
            ]
          },
          {
            "field": "etapa",
            "label": "Etapa operacional",
            "type": "select",
            "options": [
              {
                "label": "Todas",
                "value": ""
              },
              {
                "label": "Faturado pelo fornecedor",
                "value": "Faturado pelo fornecedor"
              },
              {
                "label": "Recebido",
                "value": "Recebido"
              },
              {
                "label": "Pago",
                "value": "Pago"
              },
              {
                "label": "Concluído",
                "value": "Concluído"
              }
            ]
          },
          {
            "field": "statusAprovacao",
            "label": "Aprovação",
            "type": "select",
            "options": [
              {
                "label": "Todas",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Aprovada",
                "value": "Aprovada"
              }
            ]
          },
          {
            "field": "statusIntegracao",
            "label": "Integração",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Sincronizado",
                "value": "Sincronizado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          }
        ],
        "columns": [
          "numeroDocumentoFiscal",
          "tipoDocumentoFiscal",
          "nomeFornecedor",
          "valorFaturado",
          "statusDocumentoOmie",
          "etapa",
          "statusAprovacao",
          "nomeCategoriaFinanceira",
          "nomeContaCorrenteFinanceira",
          "dataVencimento",
          "statusIntegracao"
        ],
        "rowActions": [
          {
            "id": "aprovarCompra",
            "type": "apiAction",
            "label": "Aprovar e gerar contas-pagar",
            "icon": "check",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/compras/:id/aprovar",
            "confirm": {
              "title": "Aprovar e gerar contas-pagar",
              "description": "O documento fiscal será aprovado e incluído na conta a pagar agrupada do fornecedor."
            },
            "hiddenWhen": {
              "field": "statusAprovacao",
              "equals": "Aprovada"
            },
            "refresh": [
              "self",
              "all"
            ]
          }
        ]
      },
      "detailModal": {
        "enabled": true,
        "titleField": "numeroDocumentoFiscal",
        "size": "xl",
        "defaultTab": "dados",
        "tabs": [
          {
            "id": "dados",
            "label": "Dados e parâmetros",
            "type": "form",
            "groups": [
              {
                "label": "Documento fiscal",
                "fields": [
                  "numeroDocumentoFiscal",
                  "tipoDocumentoFiscal",
                  "modeloDocumentoFiscal",
                  "serieDocumentoFiscal",
                  "dataEmissaoDocumentoFiscal",
                  "chaveDocumentoFiscal",
                  "nomeFornecedor",
                  "valorFaturado",
                  "statusDocumentoOmie",
                  "codigoEtapaRecebimentoOmie",
                  "etapa",
                  "statusAprovacao",
                  "dataVencimento"
                ],
                "columns": 2
              },
              {
                "label": "Pedido de compra relacionado",
                "fields": [
                  "codigoPedidoOmie",
                  "numeroPedido"
                ],
                "columns": 2
              },
              {
                "label": "Parâmetros para aprovação manual",
                "fields": [
                  "categoriaFinanceiraId",
                  "contaCorrenteFinanceiraId"
                ],
                "columns": 2
              },
              {
                "label": "Integração",
                "fields": [
                  "codigoRecebimentoOmie",
                  "statusConclusaoOmie",
                  "ultimaSincronizacaoEm",
                  "ultimoErro"
                ],
                "columns": 2
              }
            ]
          }
        ]
      }
    },
    {
      "model": "ContaPagarAgrupada",
      "mode": "dynamic",
      "path": "/contas-pagar-agrupadas",
      "label": "Contas a pagar agrupadas",
      "section": "Financeiro",
      "form": [
        {
          "field": "categoriaOmieId",
          "referenceFilters": {
            "status": "Ativo"
          }
        },
        {
          "field": "contaCorrenteOmieId",
          "referenceFilters": {
            "status": "Ativo"
          }
        }
      ],
      "list": {
        "filters": [
          {
            "field": "statusEnvioOmie",
            "label": "Envio para o Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Não enviado",
                "value": "Não enviado"
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Enviado",
                "value": "Enviado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          },
          {
            "field": "statusPagamentoOmie",
            "label": "Pagamento no Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Não consultado",
                "value": "Não consultado"
              },
              {
                "label": "Consultando",
                "value": "Consultando"
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Parcial",
                "value": "Parcial"
              },
              {
                "label": "Pago",
                "value": "Pago"
              },
              {
                "label": "Cancelado",
                "value": "Cancelado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          }
        ],
        "columns": [
          "nomeFornecedor",
          "dataVencimento",
          "geracao",
          "quantidadeCompras",
          "valorTotal",
          "categoriaOmieId",
          "contaCorrenteOmieId",
          "statusEnvioOmie",
          "statusPagamentoOmie",
          "status",
          "codigoLancamentoIntegracao"
        ],
        "rowActions": [
          {
            "id": "enviarContaPagar",
            "type": "apiAction",
            "label": "Enviar para o Omie",
            "icon": "send",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/contas/:id/enviar",
            "confirm": {
              "title": "Enviar conta a pagar",
              "description": "A conta será criada ou terá o valor em aberto atualizado no Omie."
            },
            "disabledWhen": {
              "field": "status",
              "in": [
                "Paga",
                "Excluída"
              ]
            },
            "refresh": [
              "self",
              "all"
            ]
          },
          {
            "id": "consultarPagamentoContaPagar",
            "type": "apiAction",
            "label": "Consultar pagamento no Omie",
            "icon": "refresh",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/contas/:id/consultar-pagamento",
            "confirm": {
              "title": "Consultar pagamento",
              "description": "Será gerado um ticket para consultar o título no Omie e atualizar a situação de pagamento na Central."
            },
            "disabledWhen": {
              "field": "status",
              "in": [
                "Pendente envio",
                "Excluída"
              ]
            },
            "refresh": [
              "self",
              "all"
            ]
          },
          {
            "id": "excluirContaLocal",
            "type": "apiAction",
            "label": "Excluir conta",
            "icon": "delete",
            "method": "DELETE",
            "endpoint": "/api/tazay/contas-pagar/contas/:id",
            "confirm": {
              "title": "Excluir conta a pagar",
              "description": "Contas já sincronizadas devem ser excluídas primeiro no Omie. Os documentos voltarão para aprovação."
            },
            "refresh": [
              "self",
              "all"
            ]
          }
        ],
        "builtInActions": {
          "create": false,
          "edit": true,
          "delete": false
        }
      },
      "detailModal": {
        "enabled": true,
        "titleField": "nomeFornecedor",
        "size": "xl",
        "defaultTab": "dados",
        "tabs": [
          {
            "id": "dados",
            "label": "Dados e parâmetros",
            "type": "form",
            "groups": [
              {
                "label": "Conta agrupada",
                "fields": [
                  "nomeFornecedor",
                  "dataVencimento",
                  "quantidadeCompras",
                  "valorTotal",
                  "status",
                  "codigoLancamentoIntegracao",
                  "codigoLancamentoOmie"
                ],
                "columns": 2
              },
              {
                "label": "Situação no Omie",
                "fields": [
                  "statusEnvioOmie",
                  "statusPagamentoOmie",
                  "statusTituloOmie",
                  "valorPagarOmie",
                  "ultimaConsultaPagamentoEm"
                ],
                "columns": 2
              },
              {
                "label": "Parâmetros para envio manual",
                "fields": [
                  "categoriaOmieId",
                  "contaCorrenteOmieId"
                ],
                "columns": 2
              },
              {
                "label": "Integração",
                "fields": [
                  "revisao",
                  "consultaPagamentoRevisao",
                  "ultimaSincronizacaoEm",
                  "ultimoErro"
                ],
                "columns": 1
              }
            ]
          },
          {
            "id": "documentos",
            "label": "NF-es e CT-es relacionadas",
            "type": "readonlyGrid",
            "relation": "documentos",
            "columns": [
              "numeroDocumentoFiscal",
              "tipoDocumentoFiscal",
              "nomeFornecedor",
              "valorFaturado",
              "statusDocumentoOmie",
              "statusAprovacao",
              "dataVencimento",
              "statusIntegracao"
            ]
          }
        ]
      },
      "relations": {
        "documentos": {
          "model": "Compra",
          "foreignKey": "contaPagarId",
          "label": "NF-es e CT-es relacionadas"
        }
      }
    },
    {
      "model": "ConfiguracaoContasPagar",
      "mode": "dynamic",
      "path": "/configuracoes-contas-pagar",
      "label": "Parâmetros da operação",
      "section": "Configurações",
      "hidden": true,
      "form": [
        {
          "field": "aprovarCompraAutomatico",
          "widget": "checkbox"
        },
        {
          "field": "enviarContaPagarOmieAutomatico",
          "widget": "checkbox"
        },
        {
          "field": "categoriaPadraoId",
          "referenceFilters": {
            "status": "Ativo"
          }
