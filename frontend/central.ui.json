      "label": "Configurações",
      "title": "Configurações",
      "section": "Sistema",
      "icon": "⚙",
      "order": 900,
      "blocks": [
        {
          "type": "navigation.cards",
          "title": "Configurações da Central",
          "columns": 2,
          "cards": [
            {
              "title": "Integração Omie",
              "description": "Credenciais, sincronização, webhooks, gatilhos e histórico organizados em abas.",
