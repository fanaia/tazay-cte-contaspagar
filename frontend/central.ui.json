      "path": "/compras",
      "label": "Documentos fiscais",
      "section": "Operação",
      "list": {
        "filters": [
          {
            "field": "tipoDocumentoFiscal",
            "label": "Tipo de documento",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "NF-e",
                "value": "NF-e"
              },
              {
                "label": "CT-e",
                "value": "CT-e"
              }
            ]
          },
          {
            "field": "statusDocumentoOmie",
            "label": "Status no Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Recebido",
                "value": "Recebido"
              },
              {
                "label": "Cancelado",
                "value": "Cancelado"
              },
              {
                "label": "Devolvido",
                "value": "Devolvido"
              },
              {
                "label": "Denegado",
                "value": "Denegado"
              }
            ]
          },
          {
            "field": "etapa",
            "label": "Etapa operacional",
            "type": "select",
            "options": [
              {
                "label": "Todas",
                "value": ""
              },
              {
                "label": "Faturado pelo fornecedor",
                "value": "Faturado pelo fornecedor"
              },
              {
                "label": "Recebido",
                "value": "Recebido"
              },
              {
                "label": "Pago",
                "value": "Pago"
              },
              {
                "label": "Concluído",
                "value": "Concluído"
              }
            ]
          },
          {
            "field": "statusAprovacao",
            "label": "Aprovação",
            "type": "select",
            "options": [
              {
                "label": "Todas",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Aprovada",
                "value": "Aprovada"
              }
            ]
          },
          {
            "field": "statusIntegracao",
            "label": "Integração",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Sincronizado",
                "value": "Sincronizado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          }
        ],
        "columns": [
          "numeroDocumentoFiscal",
          "tipoDocumentoFiscal",
          "nomeFornecedor",
          "valorFaturado",
          "statusDocumentoOmie",
          "etapa",
          "statusAprovacao",
          "nomeCategoriaFinanceira",
          "nomeContaCorrenteFinanceira",
          "dataVencimento",
          "statusIntegracao"
        ],
        "rowActions": [
          {
            "id": "aprovarDocumentoFiscal",
            "type": "apiAction",
            "label": "Aprovar",
            "icon": "check",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/compras/:id/aprovar",
            "confirm": {
              "title": "Aprovar documento fiscal",
              "description": "O documento será aprovado e criará ou atualizará a conta a pagar agrupada na Central."
            },
            "hiddenWhen": {
              "field": "acaoAprovacaoManualDisponivel",
              "equals": false
            },
            "refresh": [
              "self",
              "all"
            ]
          },
          {
            "id": "recusarDocumentoFiscal",
            "type": "apiAction",
            "label": "Recusar",
            "icon": "close",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/compras/:id/recusar",
            "confirm": {
              "title": "Recusar documento fiscal",
              "description": "O recebimento fiscal será excluído no Omie e o documento será marcado como recusado e cancelado na Central."
            },
            "hiddenWhen": {
              "field": "acaoAprovacaoManualDisponivel",
              "equals": false
            },
            "refresh": [
              "self",
              "all"
            ]
          }
        ],
        "builtInActions": {
          "create": false,
          "edit": false,
          "delete": false
        }
      },
      "detailModal": {
        "enabled": true,
        "titleField": "numeroDocumentoFiscal",
        "size": "xl",
        "defaultTab": "dados",
        "tabs": [
          {
            "id": "dados",
            "label": "Dados e parâmetros",
            "type": "form",
            "groups": [
              {
                "label": "Documento fiscal",
                "fields": [
                  "numeroDocumentoFiscal",
                  "tipoDocumentoFiscal",
                  "modeloDocumentoFiscal",
                  "serieDocumentoFiscal",
                  "dataEmissaoDocumentoFiscal",
                  "chaveDocumentoFiscal",
                  "nomeFornecedor",
                  "valorFaturado",
                  "statusDocumentoOmie",
                  "codigoEtapaRecebimentoOmie",
                  "etapa",
                  "statusAprovacao",
                  "dataVencimento"
                ],
                "columns": 2
              },
              {
                "label": "Pedido de compra relacionado",
                "fields": [
                  "codigoPedidoOmie",
                  "numeroPedido"
                ],
                "columns": 2
              },
              {
                "label": "Integração",
                "fields": [
                  "codigoRecebimentoOmie",
                  "statusConclusaoOmie",
                  "ultimaSincronizacaoEm",
                  "ultimoErro",
                  "canceladaEm",
                  "canceladaAposPagamento",
                  "observacaoOperacional"
                ],
                "columns": 2
              }
            ]
          }
        ]
      }
    },
    {
      "model": "ContaPagarAgrupada",
      "mode": "dynamic",
      "path": "/contas-pagar-agrupadas",
      "label": "Contas a pagar agrupadas",
      "section": "Financeiro",
      "list": {
        "filters": [
          {
            "field": "statusEnvioOmie",
            "label": "Envio para o Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Não enviado",
                "value": "Não enviado"
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Enviado",
                "value": "Enviado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          },
          {
            "field": "statusPagamentoOmie",
            "label": "Pagamento no Omie",
            "type": "select",
            "options": [
              {
                "label": "Todos",
                "value": ""
              },
              {
                "label": "Não consultado",
                "value": "Não consultado"
              },
              {
                "label": "Consultando",
                "value": "Consultando"
              },
              {
                "label": "Pendente",
                "value": "Pendente"
              },
              {
                "label": "Parcial",
                "value": "Parcial"
              },
              {
                "label": "Pago",
                "value": "Pago"
              },
              {
                "label": "Cancelado",
                "value": "Cancelado"
              },
              {
                "label": "Erro",
                "value": "Erro"
              }
            ]
          }
        ],
        "columns": [
          "nomeFornecedor",
          "tipoDocumentoFiscal",
          "dataVencimento",
          "geracao",
          "quantidadeCompras",
          "valorTotal",
          "categoriaOmieId",
          "contaCorrenteOmieId",
          "statusEnvioOmie",
          "statusPagamentoOmie",
          "status",
          "codigoLancamentoIntegracao"
        ],
        "rowActions": [
          {
            "id": "enviarContaPagar",
            "type": "apiAction",
            "label": "Enviar para Omie",
            "icon": "send",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/contas/:id/enviar",
            "confirm": {
              "title": "Enviar conta a pagar para o Omie",
              "description": "A conta agrupada será criada ou atualizada no Omie."
            },
            "hiddenWhen": {
              "field": "acaoSincronizacaoManualDisponivel",
              "equals": false
            },
            "disabledWhen": {
              "field": "status",
              "in": [
                "Paga",
                "Excluída",
                "Exclusão pendente"
              ]
            },
            "refresh": [
              "self",
              "all"
            ]
          },
          {
            "id": "verificarPagamentoContaPagar",
            "type": "apiAction",
            "label": "Verificar pagamento",
            "icon": "refresh",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/contas/:id/consultar-pagamento",
            "confirm": {
              "title": "Verificar pagamento no Omie",
              "description": "Será feita uma única consulta ao título no Omie para atualizar a situação do pagamento na Central."
            },
            "hiddenWhen": {
              "field": "acaoSincronizacaoManualDisponivel",
              "equals": false
            },
            "disabledWhen": {
              "field": "statusEnvioOmie",
              "in": [
                "Não enviado",
                "Pendente",
                "Erro"
              ]
            },
            "refresh": [
              "self",
              "all"
            ]
          },
          {
            "id": "excluirContaOmie",
            "type": "apiAction",
            "label": "Excluir conta",
            "method": "DELETE",
            "endpoint": "/api/tazay/contas-pagar/contas/:id",
            "confirm": {
              "title": "Excluir e regenerar conta a pagar",
              "description": "A conta será excluída no Omie. A Central criará automaticamente uma nova conta e atualizará as referências dos documentos elegíveis."
            },
            "disabledWhen": {
              "field": "status",
              "in": [
                "Paga",
                "Excluída",
                "Exclusão pendente"
              ]
            },
            "refresh": [
              "self",
              "all"
            ],
            "icon": "trash",
            "iconOnly": true
          }
        ],
        "builtInActions": {
          "create": false,
          "edit": false,
          "delete": false
        }
      },
      "detailModal": {
        "enabled": true,
        "titleField": "nomeFornecedor",
        "size": "xl",
        "defaultTab": "dados",
        "tabs": [
          {
            "id": "dados",
            "label": "Dados e parâmetros",
            "type": "form",
            "groups": [
              {
                "label": "Conta agrupada",
                "fields": [
                  "nomeFornecedor",
                  "tipoDocumentoFiscal",
                  "dataVencimento",
                  "quantidadeCompras",
                  "valorTotal",
                  "status",
                  "codigoLancamentoIntegracao",
                  "codigoLancamentoOmie"
                ],
                "columns": 2
              },
              {
                "label": "Situação no Omie",
                "fields": [
                  "statusEnvioOmie",
                  "statusPagamentoOmie",
                  "statusTituloOmie",
                  "valorPagarOmie",
                  "ultimaConsultaPagamentoEm"
                ],
                "columns": 2
              },
              {
                "label": "Integração",
                "fields": [
                  "revisao",
                  "consultaPagamentoRevisao",
                  "ultimaSincronizacaoEm",
                  "ultimoErro"
                ],
                "columns": 1
              }
            ]
          },
          {
            "id": "documentos",
            "label": "NF-es e CT-es relacionadas",
            "type": "readonlyGrid",
            "relation": "documentos",
            "columns": [
              "numeroDocumentoFiscal",
              "tipoDocumentoFiscal",
              "nomeFornecedor",
              "valorFaturado",
              "statusDocumentoOmie",
              "statusAprovacao",
              "dataVencimento",
              "statusIntegracao"
            ]
          }
        ]
      },
      "relations": {
        "documentos": {
          "model": "Compra",
          "foreignKey": "contaPagarId",
          "label": "NF-es e CT-es relacionadas"
        }
      }
    },
    {
      "model": "ConfiguracaoContasPagar",
      "mode": "dynamic",
      "path": "/configuracoes-contas-pagar",
      "label": "Parâmetros da operação",
      "section": "Configurações",
      "hidden": true,
      "form": [
        {
          "field": "aprovarCompraAutomatico",
          "widget": "checkbox"
        },
        {
          "field": "enviarContaPagarOmieAutomatico",
          "widget": "checkbox"
        },
        {
          "field": "categoriaPadraoId",
          "referenceFilters": {
            "status": "Ativo"
          }
        },
        {
          "field": "contaCorrentePadraoId",
          "referenceFilters": {
            "status": "Ativo"
          }
        }
      ],
      "list": {
        "columns": [
          "categoriaPadraoId",
          "contaCorrentePadraoId",
          "aprovarCompraAutomatico",
          "enviarContaPagarOmieAutomatico"
        ],
        "rowActions": [
          {
            "type": "openDetailModal",
            "label": "Configurar",
            "icon": "edit",
            "initialTab": "parametros"
          },
          {
            "id": "resetarBaseDados",
            "type": "apiAction",
            "label": "Resetar base de dados",
            "icon": "trash",
            "method": "POST",
            "endpoint": "/api/tazay/contas-pagar/configuracao/resetar-base",
            "confirm": {
              "title": "Resetar toda a base de dados",
              "description": "Todos os dados da Central serão apagados, incluindo configurações e acessos. A aplicação voltará ao primeiro acesso. Esta ação não pode ser desfeita."
            },
            "refresh": [
              "all"
            ]
          }
        ]
      },
      "detailModal": {
        "enabled": true,
        "titleField": "chave",
        "size": "lg",
        "defaultTab": "parametros",
        "tabs": [
          {
            "id": "parametros",
            "label": "Parâmetros",
            "type": "form",
            "groups": [
              {
                "label": "Automação",
                "description": "Quando uma automação estiver desabilitada, a Central exibirá as ações manuais correspondentes nos documentos fiscais ou nas contas a pagar agrupadas.",
                "fields": [
                  "aprovarCompraAutomatico",
                  "enviarContaPagarOmieAutomatico"
                ],
                "columns": 2
              },
              {
                "label": "Padrões financeiros",
                "fields": [
                  "categoriaPadraoId",
                  "contaCorrentePadraoId"
                ],
                "columns": 2
              }
            ]
          }
        ]
      }
    },
